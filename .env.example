# LTX Desktop Environment Variables
# Copy this file to .env and fill in the values you need.

# --- Development ---

# Enable Electron DevTools inspector (set to 1 to enable)
# ELECTRON_DEBUG=1

# Enable Python backend debug mode with debugpy (set to 1 to enable)
# BACKEND_DEBUG=1

# --- Backend ---

# Override the port the Python backend listens on (default: auto-assigned)
# LTX_PORT=8000

# Override the Python embed/binary URL for development
# LTX_PYTHON_URL=http://localhost:8000

# Enable SageAttention optimization (requires compatible GPU)
# USE_SAGE_ATTENTION=1

# --- Error Reporting ---

# Sentry DSN for error reporting (leave empty to disable)
# SENTRY_DSN=

# --- GitHub (optional, for Python embed downloads behind rate limits) ---

# GitHub token for downloading Python embeds from GitHub releases
# GH_TOKEN=
# GITHUB_TOKEN=
